{
  "name": "doccy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "free:3000": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./free-port.ps1\" -Port 3000",
    "dev": "node scripts/dev-with-env.mjs .env.testing.local 3000",
    "env:vote-secret": "node scripts/set-vote-fingerprint-secret.mjs .env.testing.local",
    "env:vote-secret:prod-local": "node scripts/set-vote-fingerprint-secret.mjs .env.production.local",
    "dev:testing": "node scripts/dev-with-env.mjs .env.testing.local 3000",
    "dev:prod": "node scripts/dev-with-env.mjs .env.production.local 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "test:e2e:register:prod": "node scripts/run-playwright-prod-registration.mjs",
    "prod:smoke:ensure": "node scripts/ensure-prod-smoke-doctors.mjs --env-file .env.production.local --check",
    "prod:smoke:ensure:apply": "powershell -NoProfile -Command \"$env:DOC_CY_CONFIRM_PROD='YES'; node scripts/ensure-prod-smoke-doctors.mjs --env-file .env.production.local --apply\"",
    "test:prod:smoke:local": "powershell -NoProfile -Command \"$env:PLAYWRIGHT_ENV_FILE='.env.production.local'; $env:PLAYWRIGHT_LIVE_REGISTRATION='1'; $env:PLAYWRIGHT_BASE_URL='https://www.mydoccy.com'; npx playwright test tests/prod/prod_appointment_booking_flow.spec.ts tests/prod/prod_registration_smoke.spec.ts tests/prod/prod_site_availability.spec.ts --project='Desktop Large (Chromium)' --workers=1 --reporter=line\"",
    "test:prod:registration:video:local": "powershell -NoProfile -Command \"$env:PLAYWRIGHT_ENV_FILE='.env.production.local'; $env:PLAYWRIGHT_LIVE_REGISTRATION='1'; $env:PLAYWRIGHT_BASE_URL='https://www.mydoccy.com'; npx playwright test tests/prod/prod_registration_smoke.spec.ts --config=playwright.pwa-video.config.ts --project='Desktop Large (Chromium)' --workers=1 --reporter=line --output='tmp/prod-registration-video'\"",
    "test:e2e:i18n-smoke": "playwright test tests/landing_i18n.spec.ts tests/language_switcher.spec.ts",
    "test:e2e:safe": "powershell -NoProfile -Command \"$env:PLAYWRIGHT_SAFE_NO_BOOKING='1'; npx playwright test\"",
    "test:e2e:ui": "playwright test --ui",
    "test:content:blog-images": "node scripts/test-blog-single-image.mjs",
    "test:content:messages-parity": "node scripts/validate-messages-parity.mjs",
    "test:unit": "npx --yes tsx --test tests/unit/finder-distance.test.ts tests/unit/finder-specialty-filter.test.ts tests/unit/clinic-location.test.ts tests/unit/register-clinic-location.test.ts tests/unit/settings-form-dirty.test.ts tests/unit/doctor-slug.test.ts tests/unit/phone-link.test.ts tests/unit/manual-directory-seo.test.ts tests/unit/generate-manual-directory-migration.test.ts tests/unit/manual-directory-name-clean.test.ts tests/unit/supabase-fetch-all.test.ts tests/unit/doctor-test-profile.test.ts tests/unit/finder-manual-preview-calendar.test.ts",
    "brand:guide:pdf": "node scripts/export-brand-guide-pdf.mjs",
    "diagnose:qr:utm": "node scripts/check-qr-utm-redirect.mjs",
    "whatsapp:test": "node scripts/send-whatsapp-test.mjs",
    "demo:doctor-verification-email": "node scripts/demo-doctor-verification-email.mjs --env-file .env.local",
    "demo:doctor-verification-email:pause": "node scripts/demo-doctor-verification-email.mjs --env-file .env.local --pause-before-verify",
    "test:integration:doctor-access": "powershell -NoProfile -Command \"$env:PLAYWRIGHT_ENV_FILE='.env.local'; $env:PLAYWRIGHT_BASE_URL='http://localhost:3000'; $env:INTEGRATION_SAFE_ENV='1'; node scripts/run-integration-with-cleanup.mjs tests/integration/doctor_account_access.integration.spec.ts tests/agenda_auth.spec.ts --project='Desktop Large (Chromium)' --workers=1 --reporter=list\"",
    "test:integration:doctor-access:headed": "powershell -NoProfile -Command \"$env:PLAYWRIGHT_ENV_FILE='.env.local'; $env:PLAYWRIGHT_BASE_URL='http://localhost:3000'; $env:INTEGRATION_SAFE_ENV='1'; node scripts/run-integration-with-cleanup.mjs tests/integration/doctor_account_access.integration.spec.ts tests/agenda_auth.spec.ts --project='Desktop Large (Chromium)' --workers=1 --reporter=list --headed\"",
    "test:integration:doctor-access:ui": "powershell -NoProfile -Command \"$env:PLAYWRIGHT_ENV_FILE='.env.local'; $env:PLAYWRIGHT_BASE_URL='http://localhost:3000'; $env:INTEGRATION_SAFE_ENV='1'; node scripts/run-integration-with-cleanup.mjs tests/integration/doctor_account_access.integration.spec.ts tests/agenda_auth.spec.ts --project='Desktop Large (Chromium)' --workers=1 --ui\"",
    "test:integration:testing:service-menu": "powershell -NoProfile -Command \"$env:PLAYWRIGHT_ENV_FILE='.env.testing.local'; $env:PLAYWRIGHT_BASE_URL='http://localhost:3100'; $env:PLAYWRIGHT_WEB_SERVER_COMMAND='node scripts/dev-with-env.mjs .env.testing.local 3100'; $env:INTEGRATION_SAFE_ENV='1'; node scripts/run-integration-with-cleanup.mjs tests/integration/service_menu_public_profile.integration.spec.ts --project='Desktop Large (Chromium)' --reporter=line\"",
    "test:integration:testing:settings-address-notice": "powershell -NoProfile -Command \"$env:PLAYWRIGHT_ENV_FILE='.env.testing.local'; $env:PLAYWRIGHT_BASE_URL='http://localhost:3100'; $env:PLAYWRIGHT_WEB_SERVER_COMMAND='node scripts/dev-with-env.mjs .env.testing.local 3100'; $env:INTEGRATION_SAFE_ENV='1'; node scripts/run-integration-with-cleanup.mjs tests/integration/settings_clinic_address_notice.integration.spec.ts --project='Desktop Large (Chromium)' --reporter=line\"",
    "test:integration:testing:settings-address-notice:video": "powershell -NoProfile -Command \"$env:PLAYWRIGHT_ENV_FILE='.env.testing.local'; $env:PLAYWRIGHT_BASE_URL='http://localhost:3100'; $env:PLAYWRIGHT_WEB_SERVER_COMMAND='node scripts/dev-with-env.mjs .env.testing.local 3100'; $env:INTEGRATION_SAFE_ENV='1'; node scripts/run-integration-with-cleanup.mjs tests/integration/settings_clinic_address_notice.integration.spec.ts --config=playwright.pwa-video.config.ts --project='Desktop Large (Chromium)' --reporter=line --output='tmp/settings-address-notice-video'\"",
    "test:integration:testing:service-menu-ui:video": "powershell -NoProfile -Command \"$env:PLAYWRIGHT_ENV_FILE='.env.testing.local'; $env:PLAYWRIGHT_BASE_URL='http://localhost:3100'; $env:PLAYWRIGHT_WEB_SERVER_COMMAND='node scripts/dev-with-env.mjs .env.testing.local 3100'; $env:INTEGRATION_SAFE_ENV='1'; node scripts/run-integration-with-cleanup.mjs tests/integration/service_menu_settings_ui.integration.spec.ts --config=playwright.pwa-video.config.ts --project='Desktop Large (Chromium)' --reporter=line --output='tmp/service-menu-ui-video'\"",
    "test:e2e:pwa:video:tmp": "node -e \"require('fs').rmSync('tmp/pwa-video',{recursive:true,force:true})\" && npx playwright test tests/pwa_install_banner.spec.ts --config=playwright.pwa-video.config.ts --project=\"Mobile Chrome (Pixel 5)\" --project=\"Mobile Safari (iPhone 12)\" --reporter=line --output=\"tmp/pwa-video\"",
    "test:cleanup:testing": "powershell -NoProfile -Command \"$env:PLAYWRIGHT_ENV_FILE='.env.testing.local'; node scripts/cleanup-test-doctors.mjs\"",
    "test:cleanup:testing:dry": "powershell -NoProfile -Command \"$env:PLAYWRIGHT_ENV_FILE='.env.testing.local'; node scripts/cleanup-test-doctors.mjs --dry-run\"",
    "test:cleanup:testing:assert": "powershell -NoProfile -Command \"$env:PLAYWRIGHT_ENV_FILE='.env.testing.local'; node scripts/cleanup-test-doctors.mjs --assert-empty\"",
    "seed:languages": "node scripts/seed-doctor-languages.mjs",
    "db:local:reset": "supabase db reset",
    "db:status": "node scripts/supabase-safe.mjs status",
    "db:testing:link": "node scripts/supabase-safe.mjs link-testing",
    "db:testing:push": "node scripts/supabase-safe.mjs push-testing",
    "db:prod:link": "node scripts/supabase-safe.mjs link-prod",
    "db:prod:push": "node scripts/supabase-safe.mjs push-prod"
  },
  "dependencies": {
    "@supabase/auth-helpers-nextjs": "^0.8.0",
    "@supabase/supabase-js": "^2.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "lucide-react": "^0.577.0",
    "next": "14.2.0",
    "next-intl": "^4.8.3",
    "next-mdx-remote": "^6.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^18",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18",
    "react-easy-crop": "^5.5.7",
    "react-international-phone": "^4.2.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.4",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "dotenv": "^17.3.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.0",
    "postcss": "^8",
    "tailwindcss": "^3",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
}
