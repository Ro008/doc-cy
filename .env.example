# Public (browser)
# Environment model:
# - Local/testing runtime uses .env.testing.local (npm run dev / npm run dev:testing)
# - Production-target runtime uses .env.production.local (npm run dev:prod / prod smoke scripts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Prod nightly smoke (copy from GitHub secrets — same values as CI):
# TEST_BOOKING_DOCTOR_SLUG=
# TEST_DOCTOR_EMAIL=
# TEST_DOCTOR_PASSWORD=
# Optional: public site URL for QR codes / booking links (default https://www.mydoccy.com). Use http://localhost:3000 for local testing.
# NEXT_PUBLIC_SITE_URL=
# Browser: Google Places autocomplete for clinic address in doctor settings (Maps JavaScript API + Places API).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Google Ads gtag. Production Vercel (VERCEL_ENV=production) loads AW-18396180836 automatically.
# Set to off/0/false to disable. Set the Ads ID explicitly only to test the tag in local/preview.
# NEXT_PUBLIC_GOOGLE_ADS_ID=
# GA4 measurement ID. Production loads G-FE3FCHCR1K automatically (same gtag as Ads; do not paste a second snippet).
# Set to off/0/false to disable. Set G-… explicitly only to test Analytics in local/preview.
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Optional overrides for conversion send_to (defaults live in lib/google-ads.ts).
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_CALL_TO_BOOK=
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_REQUEST_ONLINE_BOOKING=
# Integration / local testing only: show is_test_profile doctors in /finder (never on prod Vercel).
# Founding Members counter still includes them in both environments.
# NEXT_PUBLIC_DOC_CY_FINDER_INCLUDE_TEST_PROFILES=1
# Trial period length in days (Founder dashboard reminders; default: 180 / 6 months)
# TRIAL_PERIOD_DAYS=180

# Server-only: bypasses RLS — required for POST /api/appointments, success + .ics routes, and /internal/directory
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: email substrings that mark a doctor as test (Finder hidden on prod). Default: rociosirvent
# DOC_CY_TEST_DOCTOR_EMAIL_MARKERS=rociosirvent

# Server-only (optional): disable in-memory rate limits on public write APIs (votes / invitations / bookings / traffic log).
# Default: enabled. Set to off/0/false for local stress tests only — never in production.
# DOC_CY_PUBLIC_API_RATE_LIMIT=off

# Server-only (optional): anti-spam for finder manual-card calendar slot votes.
# Without this variable: requests still save; each click is a new row (easy to inflate).
# With it: set a long random secret, restart dev / redeploy — then the same network cannot stack many requests on the same listing in 90 days.
# Local (testing DB): `npm run env:vote-secret` → writes `.env.testing.local`.
# Production: run `npm run db:prod:push` so Supabase prod has the `voter_key` migration; add `DOC_CY_VOTE_FINGERPRINT_SECRET` in Vercel → Environment Variables → Production (any long random hex string). Optional: `npm run env:vote-secret:prod-local` writes the same key into `.env.production.local` for local `dev:prod` — use a different secret than testing if you prefer.
# DOC_CY_VOTE_FINGERPRINT_SECRET=

# Optional: same random string in Vercel + Playwright env so automated E2E tests do not write website_visits rows.
# Header: x-doccy-suppress-traffic-log: <this value>
# DOC_CY_SUPPRESS_TRAFFIC_LOG_SECRET=

# Shared secret for /internal gate; cookie is set when password matches
INTERNAL_DIRECTORY_SECRET=

# Resend (booking emails). Domain mydoccy.com must be verified in Resend.
RESEND_API_KEY=
# Founder email when a professional completes signup (comma-separated emails OK)
# FOUNDER_NOTIFY_EMAIL=you@example.com
# Optional: override From (default: DocCy <no-reply@mydoccy.com>). Use for dev e.g. Resend onboarding sender.
# RESEND_FROM=DocCy <onboarding@resend.dev>
# Optional: redirect all outbound mail in non-prod (monthly digest respects this too).
# RESEND_TO_OVERRIDE=you@example.com

# Server-only: protects /api/cron/* routes (Vercel Cron sends Authorization: Bearer <CRON_SECRET>).
# Must be ASCII-only (letters, digits, symbols) — no accents or spaces. Example: openssl rand -hex 32
# CRON_SECRET=
# Hourly cron `/api/cron/finder-traffic-alert` emails FOUNDER_NOTIFY_EMAIL when /finder traffic is
# ≥3× the same hour's 7-day average and ≥100 human views/hour (6h cooldown between alerts).
