# Public (browser)
# Environment model:
# - Local/testing runtime uses .env.testing.local (npm run dev / npm run dev:testing)
# - Production-target runtime uses .env.production.local (npm run dev:prod / prod smoke scripts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: public site URL for QR codes / booking links (default https://www.mydoccy.com). Use http://localhost:3000 for local testing.
# NEXT_PUBLIC_SITE_URL=
# Integration / local testing only: show is_test_profile doctors in /finder (never on prod Vercel).
# Founding Members counter still includes them in both environments.
# NEXT_PUBLIC_DOC_CY_FINDER_INCLUDE_TEST_PROFILES=1
# Trial period length in days (Founder dashboard reminders; default: 90)
# TRIAL_PERIOD_DAYS=90

# Server-only: bypasses RLS — required for POST /api/appointments, success + .ics routes, and /internal/directory
SUPABASE_SERVICE_ROLE_KEY=

# Server-only (optional): anti-spam for finder "Vote for Online Booking".
# Without this variable: votes still save; each click is a new row (easy to inflate).
# With it: set a long random secret, restart dev / redeploy — then the same network cannot stack many votes on the same listing in 90 days.
# Local (testing DB): `npm run env:vote-secret` → writes `.env.testing.local`.
# Production: run `npm run db:prod:push` so Supabase prod has the `voter_key` migration; add `DOC_CY_VOTE_FINGERPRINT_SECRET` in Vercel → Environment Variables → Production (any long random hex string). Optional: `npm run env:vote-secret:prod-local` writes the same key into `.env.production.local` for local `dev:prod` — use a different secret than testing if you prefer.
# DOC_CY_VOTE_FINGERPRINT_SECRET=

# Optional: same random string in Vercel + Playwright env so automated E2E tests do not write website_visits rows.
# Header: x-doccy-suppress-traffic-log: <this value>
# DOC_CY_SUPPRESS_TRAFFIC_LOG_SECRET=

# Shared secret for /internal gate; cookie is set when password matches
INTERNAL_DIRECTORY_SECRET=

# Resend (booking emails). Domain mydoccy.com must be verified in Resend.
RESEND_API_KEY=
# Founder alert when a professional completes signup (comma-separated emails OK)
# FOUNDER_NOTIFY_EMAIL=you@example.com
# WhatsApp alerts (CallMeBot-style webhook: URL without hardcoded text=; we set ?text= on send)
# WHATSAPP_WEBHOOK_URL=          # CI nightly + optional fallback for founder signup alerts
# FOUNDER_REGISTRATION_WHATSAPP_WEBHOOK_URL=  # optional override for signup only
# Local test: node scripts/send-whatsapp-test.mjs "Hello from DocCy"
# Optional: override From (default: DocCy <no-reply@mydoccy.com>). Use for dev e.g. Resend onboarding sender.
# RESEND_FROM=DocCy <onboarding@resend.dev>
# Optional: redirect all outbound mail in non-prod (monthly digest respects this too).
# RESEND_TO_OVERRIDE=you@example.com

# Server-only: protects /api/cron/* routes (Vercel Cron sends Authorization: Bearer <CRON_SECRET>).
# Must be ASCII-only (letters, digits, symbols) — no accents or spaces. Example: openssl rand -hex 32
# CRON_SECRET=
